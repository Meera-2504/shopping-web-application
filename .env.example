# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to git.

# Any long, random string — used to sign login sessions. Required.
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server runs on.
PORT=3000

# ---- Google sign-in (optional) ----
# Leave these blank and the "Log in with Google" button will show a clear
# message instead of a broken redirect. To make it work, see the
# "Google sign-in setup" section in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
